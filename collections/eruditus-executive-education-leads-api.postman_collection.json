              "raw": "{\n  \"course_code\": \"<string>\",\n  \"agree\": \"<boolean>\",\n  \"country\": \"<string>\",\n  \"last_name\": \"<string>\",\n  \"email\": \"<string>\",\n  \"phone\": \"<string>\",\n  \"utm_source\": \"<string>\",\n  \"first_name\": \"<string>\",\n  \"work_experience\": \"<string>\",\n  \"job_title\": \"<string>\",\n  \"batch_name\": \"<string>\",\n  \"utm_campaign\": \"<string>\",\n  \"utm_content\": \"<string>\",\n  \"utm_placement\": \"<string>\"\n}",
