          "request": {
            "name": "Submit an enrollment lead",
            "description": {
              "content": "Submits a lead for an Emeritus program. Send the B2C body for an individual learner, or the B2B body (`inquiring_for: \"team\"` plus `company` and `number_of_participans`) for an enterprise/team inquiry. On success the API returns the identifier of the created lead.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "generic_lead"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "LEAD_WEBHOOK_KEY"
